# Copia este archivo como .env y completa los datos
PORT=3000

# sqlite (por defecto, no necesita nada más) | supabase
DB_DRIVER=sqlite

# Solo si DB_DRIVER=supabase (Supabase > Project Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=pega-aqui-la-clave-service_role
